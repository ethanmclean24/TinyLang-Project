// StudyLang core grammar; policy and AST mapping: GRAMMAR_REVIEW.md.
// A compilation unit and every block require at least one statement.
start: _NEWLINE* statement+

?statement: simple_statement _NEWLINE
          | if_stmt
          | while_stmt
          | for_stmt
          | function_decl
?simple_statement: declaration | assignment | show_stmt | return_stmt
declaration: "let" NAME "=" expression
assignment: reference "=" expression
// The same named location can be read in an expression or written by assignment.
?reference: NAME -> variable
          | reference "[" expression "]" -> index
array_literal: "[" [elements] "]"
elements: expression ("," expression)*
show_stmt: "show" "(" expression ")"
function_decl: "function" NAME "(" [parameters] ")" ":" block
parameters: NAME ("," NAME)*
return_stmt: "return" expression
call: NAME "(" [arguments] ")"
arguments: expression ("," expression)*
if_stmt: "if" expression ":" block ["else" ":" block]
while_stmt: "while" expression ":" block
for_stmt: "for" NAME "in" expression ":" block
block: _NEWLINE _INDENT statement+ _DEDENT

?expression: or_expr
?or_expr: or_expr "or" and_expr -> logical_or
        | and_expr
?and_expr: and_expr "and" not_expr -> logical_and
         | not_expr
?not_expr: "not" not_expr -> logical_not
         | comparison
// Comparisons are nonassociative: no implicit a < b < c chaining.
?comparison: sum COMP_OP sum -> compare
           | sum
?sum: sum "+" term -> add
    | sum "-" term -> subtract
    | term
?term: term "*" factor -> multiply
     | term "/" factor -> divide
     | term "%" factor -> remainder
     | factor
?factor: NUMBER -> number
       | NEGATIVE_NUMBER -> number
       | STRING -> string
       | "True" -> true
       | "False" -> false
       | reference
       | array_literal
       | call
       | "ask" "(" expression ")" -> ask
       | "(" expression ")"

COMP_OP: "==" | "!=" | "<=" | ">=" | "<" | ">"
// Reserve the implemented keywords while allowing names such as total_questions.
NAME: /(?!(let|show|ask|if|else|while|for|in|function|return|True|False|and|or|not)\b)[a-zA-Z_][a-zA-Z0-9_]*/
%import common.NUMBER
// A minus attached to a literal is supported, not general unary arithmetic.
NEGATIVE_NUMBER: "-" NUMBER
// Small explicit escape set: quote, backslash, newline, tab, carriage return.
STRING: /"([^"\\\r\n]|\\["\\ntr])*"/
%import common.WS_INLINE
%import common.SH_COMMENT
%ignore WS_INLINE
%ignore SH_COMMENT
// Keep newlines, indentation, and comment-only lines visible to the indenter.
_NEWLINE: ( /\r?\n[\t ]*/ | SH_COMMENT )+
%declare _INDENT _DEDENT
